<%# locals: (book:) %>
<%= form_with model: book, class: "book-form", data: { controller: "book-lookup" } do |f| %>
  <% if book.errors.any? %>
    <div class="form-errors">
      <% book.errors.each do |error| %>
        <p class="form-error"><%= error.full_message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "Title" %>
    <div class="lookup-wrap">
      <%= f.text_field :title, required: true, autofocus: true,
          data: { book_lookup_target: "title" } %>
      <button type="button" class="btn btn--ghost btn--sm"
              data-action="click->book-lookup#lookup">Look up</button>
    </div>
    <div class="lookup-results" data-book-lookup-target="results"></div>
  </div>

  <div class="field">
    <%= f.label :author, "Author" %>
    <%= f.text_field :author, required: true, data: { book_lookup_target: "author" } %>
  </div>

  <div class="field field--row">
    <div class="field">
      <%= f.label :year, "Year" %>
      <%= f.number_field :year, min: 1000, max: Date.current.year,
          data: { book_lookup_target: "year" } %>
    </div>
    <div class="field">
      <%= f.label :genre, "Genre" %>
      <%= f.text_field :genre, data: { book_lookup_target: "genre" } %>
    </div>
  </div>

  <fieldset class="field">
    <legend>Rating</legend>
    <div class="rating-options">
      <% Book.ratings.each_key do |rating| %>
        <label class="rating-option rating-option--<%= rating %>">
          <%= f.radio_button :rating, rating, required: true %>
          <span class="rating-dot rating-dot--<%= rating %>"></span>
          <%= rating.capitalize %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="field">
    <%= f.label :read_at, "Date read" %>
    <%= f.date_field :read_at %>
  </div>

  <div class="field field--row">
    <div class="field">
      <%= f.label :mood, "Mood(s)" %>
      <%= f.text_field :mood, placeholder: "e.g. dark/inspiring" %>
    </div>
    <div class="field">
      <%= f.label :pace, "Pace" %>
      <%= f.select :pace, [["", nil], ["Fast", "fast"], ["Medium", "medium"], ["Slow", "slow"]],
          {}, class: "field-select" %>
    </div>
  </div>

  <div class="field">
    <%= f.label :notes, "Notes" %>
    <%= f.text_area :notes, rows: 4, placeholder: "What did you think?" %>
  </div>

  <div class="form-actions">
    <%= f.submit "Save book", class: "btn btn--primary" %>
    <%= link_to "Cancel", book.persisted? ? book_path(book) : books_path, class: "btn btn--ghost" %>
  </div>
<% end %>
