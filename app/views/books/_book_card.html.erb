<%# locals: (book:) %>
<% cover_initials = book.title.split.map(&:first).first(2).join.upcase %>
<% cover_hue = %w[indigo violet blue teal rose amber][book.id % 6] %>
<% cover_src = "https://covers.openlibrary.org/b/title/#{ERB::Util.url_encode(book.title)}-M.jpg" %>

<article class="lib-card">
  <div class="lib-card__cover-wrap">
    <div class="book-cover book-cover--sm book-cover--<%= cover_hue %>">
      <span class="book-cover__initials" aria-hidden="true"><%= cover_initials %></span>
      <img class="book-cover__img"
           src="<%= cover_src %>"
           alt=""
           onload="if(this.naturalWidth>20&&this.naturalHeight>20)this.classList.add('loaded')"
           onerror="this.remove()" />
    </div>
    <div class="lib-card__actions">
      <%= link_to "View", book_path(book), class: "lib-card__action", data: { turbo_frame: "_top" } %>
      <%= link_to "Edit", edit_book_path(book), class: "lib-card__action", data: { turbo_frame: "_top" } %>
      <%= button_to "Delete", book_path(book),
          method: :delete,
          class: "lib-card__action lib-card__action--danger",
          form: { data: { turbo_confirm: "Remove #{book.title} from your library?" } } %>
    </div>
  </div>

  <div class="lib-card__meta">
    <%= link_to book.title, book_path(book), class: "lib-card__title-link", data: { turbo_frame: "_top" } %>
    <span class="lib-card__author"><%= book.author %></span>
    <div class="lib-card__footer">
      <span class="rating-badge rating-badge--<%= book.rating %>"><%= book.rating.humanize %></span>
      <% if book.genre.present? %>
        <span class="lib-card__genre"><%= book.genre %></span>
      <% end %>
    </div>
  </div>
</article>
