<div class="book-detail">
  <div class="book-detail__header">
    <span class="rating-dot rating-dot--<%= @book.rating %>"></span>
    <span class="rating-label"><%= @book.rating.capitalize %></span>
    <% if @book.year.present? %>
      <span class="book-year"><%= @book.year %></span>
    <% end %>
  </div>

  <h1 class="book-detail__title"><%= @book.title %></h1>
  <p class="book-detail__author"><%= @book.author %></p>

  <% if @book.genre.present? %>
    <div class="book-tags">
      <span class="tag"><%= @book.genre %></span>
    </div>
  <% end %>

  <% if @book.notes.present? %>
    <div class="book-detail__notes">
      <p><%= @book.notes %></p>
    </div>
  <% end %>

  <div class="book-detail__actions">
    <%= link_to "Edit", edit_book_path(@book), class: "btn btn--secondary" %>
    <%= button_to "Delete book", book_path(@book), method: :delete, class: "btn btn--danger", form: {data: {turbo_confirm: "Remove #{@book.title} from your library?"}} %>
    <%= link_to "Back to Library", books_path, class: "btn btn--ghost" %>
  </div>
</div>
