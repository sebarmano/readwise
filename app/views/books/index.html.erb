<% content_for :head do %>
  <%= stylesheet_link_tag "books", "data-turbo-track": "reload" %>
<% end %>

<div data-controller="search filter">
  <div class="page-header">
    <div>
      <h2 class="page-title">Library</h2>
      <p class="page-sub"><%= pluralize(@total, "book") %> read</p>
    </div>
    <div class="header-actions">
      <%= link_to "Add book", new_book_path, class: "btn btn--primary" %>
      <%= link_to "Import CSV", new_books_import_path, class: "btn btn--ghost" %>
      <div class="search-wrap">
        <%= form_with url: books_path, method: :get,
            data: { search_target: "form", filter_target: "form", turbo_frame: "book-grid" } do |f| %>
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <%= f.search_field :q, value: params[:q], placeholder: "Search books, authors…",
              class: "search-input", id: "Search",
              data: { action: "input->search#submit" } %>
          <%= f.hidden_field :rating, value: params[:rating], data: { filter_target: "ratingInput" } %>
          <%= f.hidden_field :genre, value: params[:genre], data: { filter_target: "genreInput" } %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @reading_now.any? %>
    <div class="now-reading-section">
      <p class="now-reading-section__label">
        Reading now
        <% if @reading_now.size > 1 %>
          <span class="now-reading-section__count"><%= @reading_now.size %></span>
        <% end %>
      </p>
      <div class="now-reading-row">
        <% @reading_now.each do |rec| %>
          <% cover_hue = %w[indigo violet blue teal rose amber][rec.id % 6] %>
          <% cover_src = book_cover_path(title: rec.book_title, size: "L") %>
          <% cover_initials = rec.book_title.split.map(&:first).first(2).join.upcase %>
          <%= link_to recommendation_path(rec), class: "now-reading-card", data: { turbo_frame: "_top" } do %>
            <div class="now-reading-card__cover">
              <div class="book-cover book-cover--md book-cover--<%= cover_hue %>">
                <span class="book-cover__initials" aria-hidden="true"><%= cover_initials %></span>
                <img class="book-cover__img"
                     src="<%= cover_src %>"
                     alt="Cover of <%= rec.book_title %>"
                     onload="if(this.naturalWidth>20&&this.naturalHeight>20)this.classList.add('loaded')"
                     onerror="this.remove()" />
              </div>
            </div>
            <div class="now-reading-card__body">
              <p class="now-reading-card__title"><%= rec.book_title %></p>
              <p class="now-reading-card__author">by <%= rec.book_author %></p>
            </div>
            <div class="now-reading-card__cta" aria-hidden="true">›</div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="filter-bar">
    <div class="filter-group">
      <button type="button" class="<%= rating_chip_class(nil) %>"
              data-action="click->filter#setRating" data-filter-group="rating" data-value="">All</button>
      <button type="button" class="<%= rating_chip_class(:loved) %>"
              data-action="click->filter#setRating" data-filter-group="rating" data-value="loved">Loved</button>
      <button type="button" class="<%= rating_chip_class(:liked) %>"
              data-action="click->filter#setRating" data-filter-group="rating" data-value="liked">Liked</button>
      <button type="button" class="<%= rating_chip_class(:meh) %>"
              data-action="click->filter#setRating" data-filter-group="rating" data-value="meh">Meh</button>
    </div>
    <div class="filter-group">
      <% @genres.each do |genre| %>
        <button type="button" class="<%= genre_chip_class(genre) %>"
                data-action="click->filter#setGenre" data-filter-group="genre" data-value="<%= genre %>"><%= genre %></button>
      <% end %>
    </div>
  </div>

  <turbo-frame id="book-grid">
    <% if @books.any? %>
      <div class="book-grid">
        <% @books.each do |book| %>
          <%= render "book_card", book: book %>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state">No books found.</p>
    <% end %>
  </turbo-frame>
</div>
