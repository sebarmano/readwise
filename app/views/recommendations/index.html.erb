<% content_for :head do %>
  <%= stylesheet_link_tag "recommendations", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "friends", "data-turbo-track": "reload" %>
<% end %>

<div class="page-header">
  <div>
    <h1 class="page-title">Reading Queue</h1>
    <p class="page-sub"><%= pluralize(@recommendations.size, "recommendation") %></p>
  </div>
  <div class="header-actions">
    <%= link_to "+ Add", new_recommendation_path, class: "btn btn--primary btn--sm" %>
  </div>
</div>

<div class="rec-prompt"
     data-controller="chat"
     data-chat-question-url-value="<%= llm_question_path %>"
     data-chat-recommend-url-value="<%= llm_recommend_path %>"
     data-chat-state="idle">

  <%# ── Idle state: personal invitation ─────────────────────────────────── %>
  <div class="rec-prompt__idle" data-chat-target="inputRow">
    <div class="rec-prompt__heading">
      <span class="rec-prompt__spark" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M7 1L8.2 5.4L12.5 7L8.2 8.6L7 13L5.8 8.6L1.5 7L5.8 5.4L7 1Z" fill="currentColor"/>
        </svg>
      </span>
      <div>
        <p class="rec-prompt__title">
          <% if @last_loved %>
            Something for after <em><%= @last_loved.title %></em>?
          <% else %>
            What should you read next?
          <% end %>
        </p>
        <p class="rec-prompt__sub">I know your taste — just tap a mood or describe what you're after</p>
      </div>
    </div>

    <div class="rec-prompt__chips">
      <% @top_genres.each do |genre| %>
        <button class="rec-prompt__chip"
                data-action="click->chat#suggest"
                data-chat-value-param="<%= genre.downcase %>">
          <%= genre %>
        </button>
      <% end %>
      <button class="rec-prompt__chip"
              data-action="click->chat#suggest"
              data-chat-value-param="something dark and gripping">
        Dark &amp; gripping
      </button>
      <button class="rec-prompt__chip"
              data-action="click->chat#suggest"
              data-chat-value-param="light and fun, easy to read">
        Light read
      </button>
      <button class="rec-prompt__chip rec-prompt__chip--surprise"
              data-action="click->chat#suggest"
              data-chat-value-param="">
        Surprise me
      </button>
    </div>

    <div class="rec-prompt__input-row">
      <input type="text"
             data-chat-target="input"
             class="rec-prompt__input"
             placeholder="Or describe what you're in the mood for…"
             data-action="keydown.enter->chat#ask"
             aria-label="Describe what you want to read" />
      <button data-action="click->chat#ask" class="btn btn--primary btn--sm">
        Ask
      </button>
    </div>
  </div>

  <%# ── In-flight: chat bubbles ──────────────────────────────────────────── %>
  <div class="ai-chat" data-chat-target="chat" aria-live="polite"></div>

  <div class="ai-panel__answer-row" data-chat-target="answerRow">
    <input type="text"
           data-chat-target="answerInput"
           class="ai-panel__input"
           placeholder="Type your answer…"
           data-action="keydown.enter->chat#send"
           aria-label="Answer" />
    <button data-action="click->chat#send" class="btn btn--sm btn--primary">Send</button>
  </div>

  <div class="ai-panel__feedback-row" data-chat-target="feedbackRow">
    <p class="ai-panel__feedback-hint">Want different picks? Tell me what to change:</p>
    <div class="ai-panel__feedback-inputs">
      <input type="text"
             data-chat-target="feedbackInput"
             class="ai-panel__input"
             placeholder="e.g. more modern, less dark, shorter…"
             data-action="keydown.enter->chat#refine"
             aria-label="Feedback on recommendations" />
      <button data-action="click->chat#refine" class="btn btn--sm btn--ghost">Refine</button>
      <button data-action="click->chat#finish" class="btn btn--sm btn--primary">Done</button>
    </div>
  </div>

  <div class="ai-panel__restart">
    <button data-action="click->chat#reset">Start over</button>
  </div>
</div>

<turbo-frame id="tab-queue">
  <% grouped = @recommendations.group_by(&:status)
     reading  = grouped["reading"]  || []
     pending  = grouped["pending"]  || []
     history  = (grouped["read"] || []) + (grouped["skipped"] || []) %>

  <% if reading.empty? && pending.empty? && history.empty? %>
    <p class="empty-state">No recommendations yet — ask a friend or use the AI above.</p>
  <% else %>

    <%# ── Now reading hero (only when actively reading) ────────────────────── %>
    <% if reading.any? %>
      <% featured = reading.first %>
      <% cover_hue = %w[indigo violet blue teal rose amber][featured.id % 6] %>
      <% cover_src = book_cover_path(title: featured.book_title, size: "L") %>
      <% cover_initials = featured.book_title.split.map(&:first).first(2).join.upcase %>
      <%= link_to recommendation_path(featured), class: "now-reading-hero", data: { turbo_frame: "_top" } do %>
        <div class="now-reading-hero__cover">
          <div class="book-cover book-cover--md book-cover--<%= cover_hue %>">
            <span class="book-cover__initials" aria-hidden="true"><%= cover_initials %></span>
            <img class="book-cover__img"
                 src="<%= cover_src %>"
                 alt="Cover of <%= featured.book_title %>"
                 onload="if(this.naturalWidth>20&&this.naturalHeight>20)this.classList.add('loaded')"
                 onerror="this.remove()" />
          </div>
        </div>
        <div class="now-reading-hero__body">
          <p class="now-reading-hero__eyebrow">What are we reading today?</p>
          <p class="now-reading-hero__title"><%= featured.book_title %></p>
          <p class="now-reading-hero__author">by <%= featured.book_author %></p>
          <% if reading.size > 1 %>
            <p class="now-reading-hero__more">+<%= reading.size - 1 %> more in progress</p>
          <% end %>
        </div>
        <div class="now-reading-hero__cta" aria-hidden="true">›</div>
      <% end %>
      <% if reading.size > 1 %>
        <div class="rec-list" style="margin-bottom: var(--s2)">
          <%= render reading.drop(1) %>
        </div>
      <% end %>
    <% end %>

    <div class="rec-sections">
      <% if pending.any? %>
        <section class="rec-section">
          <h2 class="rec-section__label">
            Up Next
            <span class="rec-section__count"><%= pending.size %></span>
          </h2>
          <div class="rec-list">
            <%= render pending %>
          </div>
        </section>
      <% end %>

      <% if history.any? %>
        <details class="rec-section rec-section--history">
          <summary class="rec-section__summary">
            History
            <span class="rec-section__count"><%= history.size %></span>
          </summary>
          <div class="rec-list">
            <%= render history %>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
