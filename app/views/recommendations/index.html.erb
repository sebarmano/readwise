<% content_for :head do %>
  <%= stylesheet_link_tag "recommendations", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "friends", "data-turbo-track": "reload" %>
<% end %>

<div class="page-header">
  <div>
    <h1 class="page-title">Reading Queue</h1>
    <p class="page-sub"><%= pluralize(@recommendations.size, "recommendation") %></p>
  </div>
  <div class="header-actions">
    <%= link_to "+ Add", new_recommendation_path, class: "btn btn--primary btn--sm" %>
  </div>
</div>

<div class="llm-generate"
     data-controller="llm-stream"
     data-llm-stream-url-value="<%= llm_recommend_path %>">
  <div class="llm-generate__row">
    <input type="text"
           data-clarification
           class="llm-generate__clarification"
           placeholder="Any preferences? e.g. something fast-paced…" />
    <button data-llm-stream-target="button"
            data-action="click->llm-stream#start"
            class="btn btn--sm btn--ghost">
      Get Recommendations
    </button>
  </div>
  <div data-llm-stream-target="output" class="llm-generate__output"></div>
</div>

<turbo-frame id="tab-queue">
  <% if @recommendations.empty? %>
    <p class="empty-state">No recommendations yet. Ask a friend or generate some above.</p>
  <% else %>
    <div class="rec-list">
      <%= render @recommendations %>
    </div>
  <% end %>
</turbo-frame>
